<!--
  允许明文 HTTP。

  为什么必须开（2026-10-03 真机暴露「歌单大部分歌曲没有封面」）：
  网易云 / 酷狗 / 酷我的封面 CDN 大量仍是 `http://`（导入的真实备份里 3529 首有 2919 首是 http），
  而 Android 9+ 默认禁止明文流量 —— 结果 Coil 全部请求被拦，封面成片空白。
  口径与旧项目 `LX_Pro_FinalRebuild_0922/android/app/src/main/res/xml/network_security_config.xml` 一致。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>