<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 播放内核 / 前台服务 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 下载「仅 Wi-Fi」判定（是否非计费网络） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 开机自动扫描本地曲库（设置默认关闭，开启后才真正扫描） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 桌面歌词悬浮窗（设置页打开开关时引导用户授权） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 请求加入电池优化白名单（MIUI/ColorOS/EMUI 等国产 ROM 后台播放必须加白名单） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 本地音乐读取：minSdk 26，故按版本分流（33+ 用 READ_MEDIA_AUDIO） -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
        android:name=".LXProApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LXPro">

        <!-- M5：允许 Macrobenchmark / BaselineProfileRule 以 shell 身份 profiling -->
        <profileable
            android:shell="true"
            tools:targetApi="q" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LXPro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 深链接：lxpro://song/<Base64> 直接起播在线歌曲；lxpro://share?title=... 分享协议跨音源匹配 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lxpro" />
            </intent-filter>
        </activity>

        <!-- 前台播放服务：通知栏 / 锁屏 / 后台播放（03 §5.5）
             ⚠️ tools:ignore="Instantiatable" 是 lint 误报：LXProMediaService 继承 media3 的
             MediaSessionService（它的父类才是 android.app.Service），但 release 的 lintVital
             解析不到跨模块的父类链，误判成「不是 Service」。既不能改真实继承（会废掉
             MediaSession），也不该把这条检查整块 disable，所以只在这一处忽略。 -->
        <service
            android:name="com.lxpro.core.media.LXProMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 本地歌曲分享：下载目录在应用私有空间，file:// 必须经 FileProvider 授权给对方 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- 开机自动扫描（设置开关内部再判断，默认关闭 → 收到广播也不做事） -->
        <receiver
            android:name=".BootScanReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>